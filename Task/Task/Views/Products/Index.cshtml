@model List<Product>

<h1>Products</h1>

<table class="table">
    <thead>
        <th scope="col">Id</th>
        <th scope="col">Name</th>
        <th scope="col">Description</th>
        <th scope="col">Price</th>
        <th scope="col">rate</th>
    </thead>
    <tbody>
        @foreach(var product in Model)
        {
           <tr>
            <td>@product.Id</td>
            <td>@product.Name</td>
            <td>@product.Description</td>
            <td>@product.Price</td>
            <td>@product.rate</td>
            </tr>
        }
    </tbody>
</table>